# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dataset — raw local frames never ship; only the cleaned public subset is committed
/data/raw/
/data/frames/
*.orig.jpg
*.orig.png

# data/public: only the processed frame set + its README are committed
/data/public/*
!/data/public/README.md
# frames/ is HELD OUT of git pending: (a) laundry-room manager authorization to publish,
# (b) redaction of the vendor service sticker (phone number) + window views. Re-enable by
# deleting the next line once cleared.
/data/public/frames/
# never commit video
*.mov
*.MOV
*.mp4
*.m4v

# agent response cache — regenerated locally; curated replay caches are force-added later
/data/cache/*
!/data/cache/README.md

# private per-site config overrides
/laundry3.config.local.ts

