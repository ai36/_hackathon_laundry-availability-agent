# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dataset — raw local frames never ship; only the cleaned public subset is committed
/data/raw/
/data/frames/
*.orig.jpg
*.orig.png

# data/public: only the processed frame set + its README are committed
/data/public/*
!/data/public/README.md
!/data/public/frames/
# frames/: only the 9 labelled P0 evaluation stills are committed, each with the author's
# hand-drawn redaction boxes burned in (vendor service sticker / phone number, window and
# TV views). Video-derived frames and unlabelled stills stay local.
/data/public/frames/*
!/data/public/frames/img_1819.jpg
!/data/public/frames/img_1821.jpg
!/data/public/frames/img_1822.jpg
!/data/public/frames/img_1823.jpg
!/data/public/frames/img_1824.jpg
!/data/public/frames/img_1825.jpg
!/data/public/frames/img_1826.jpg
!/data/public/frames/img_8629.jpg
!/data/public/frames/img_8633.jpg
# never commit video
*.mov
*.MOV
*.mp4
*.m4v

# agent response cache — regenerated locally; curated replay caches are force-added later
/data/cache/*
!/data/cache/README.md

# integrator-uploaded images (camera stubs, annotated shots, machine reference states) —
# arbitrary user content, kept local. data/site-config.json (the camera list) IS committed.
/data/site-config/

# private per-site config overrides
/laundry3.config.local.ts

# agent skills — declared in skills-lock.json (committed); vendored copies + symlinks are
# fetched with `npx skills install`, not committed.
/.agents/
/.claude/skills/

